{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Custom Filament Profile Creator",
  "version": "0.1.2",
  "identifier": "fork.leanspectrum.profile-creator",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Custom Filament Profile Creator",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Filament SDS/TDS PDF -> tailored Snapmaker_Orca profile",
    "longDescription": "Reads a manufacturer Safety or Technical Data Sheet PDF, extracts the relevant chemistry and printing parameters, and creates a Snapmaker_Orca filament profile tailored to the specific filament — ready to import. Companion app to LeanSpectrum."
  },
  "plugins": {}
}
